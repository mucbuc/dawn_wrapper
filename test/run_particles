#!/usr/bin/env bash
# Builds and runs src/particles_by_hand.cpp in headless Chrome. Exit code is the
# page's: 0 when every check held.
#
# Headless WebGPU on macOS needs --enable-unsafe-webgpu and --use-angle=metal;
# without them the page never reaches main() and emrun waits forever.
set -euo pipefail
cd "$(dirname "$0")"
emcmake cmake -B web-build > /dev/null
cmake --build web-build --target Particles -j 8
exec timeout --kill-after=5 "${TIMEOUT:-60}" \
    emrun --browser chrome --kill_exit \
    --browser_args="--headless=new --enable-unsafe-webgpu --use-angle=metal --no-first-run" \
    web-build/Particles.html
