{
  "version": 1,
  "resources": {
    "source": { "kind": "storage", "element": "f32", "init": [0, 1, 3, 5, 7, 11, 13, 17] },
    "dest":   { "kind": "storage", "element": "f32", "length": "source" },
    "params": { "kind": "uniform", "members": { "multiplier": { "type": "f32", "value": 4 } } }
  },
  "groups": {
    "data":   ["source", "dest"],
    "params": ["params"]
  },
  "passes": [
    {
      "name": "multiply",
      "kind": "compute",
      "reads":  ["source", "params"],
      "writes": ["dest"],
      "workgroup_size": 64,
      "dispatch": { "over": "source" },
      "entry": "multiply",
      "wgsl": ["multiply.wgsl"]
    }
  ]
}
